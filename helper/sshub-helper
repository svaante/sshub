#!/bin/bash -p
# sshub-helper: the few sshub actions that need root, run via sudo.
#
# On the server, by sshub-server:
#   sshub-helper export <busid>            (stdin: the connected stream socket)
#   sshub-helper release <busid>
# On the client, by sshub:
#   sshub-helper attach <speed> <busnum> <devnum>   (stdin: the connected stream socket)
#   sshub-helper detach <vhci-port>
# On the client, by the udev rule:
#   sshub-helper owner <devpath>
#
# Every argument comes from an unprivileged caller and is checked here. export
# re-reads /etc/sshub/devices itself: the caller is not trusted to have
# checked it. The sysfs sequences mirror the kernel's usbip tools
# (tools/usb/usbip/src/usbip_bind.c, usbip_unbind.c, libsrc/vhci_driver.c).
set -eu
export LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFS=$' \t\n'

# Where things live. Tests run a copy with these four lines changed.
SYS=/sys
CONF=/etc/sshub
RUN=/run/sshub
ROOT_UID=0

# The devices file format; internal/share uses the same expressions.
skip_re='^[[:blank:]]*(#.*)?$'
device_re='^([0-9a-f]{4}):([0-9a-f]{4})([[:blank:]]+([^[:blank:]]+))?[[:blank:]]*$'
# A USB device in sysfs: bus number, then the port chain ("3-1", "1-2.4.1").
busid_re='^[1-9][0-9]{0,2}-[1-9][0-9]{0,2}(\.[1-9][0-9]{0,2}){0,6}$'
number_re='^(0|[1-9][0-9]{0,4})$'

host=$SYS/bus/usb/drivers/usbip-host
# vhci_hcd.0 carries the sysfs files of every vhci controller.
vhci=$SYS/devices/platform/vhci_hcd.0

die() {
	printf 'sshub-helper: %s\n' "$*" >&2
	exit 1
}

usage() {
	printf '%s\n' \
		'usage: sshub-helper export|release <busid>' \
		'       sshub-helper attach <speed> <busnum> <devnum>' \
		'       sshub-helper detach <vhci-port>' \
		'       sshub-helper owner <devpath>' >&2
	exit 2
}

valid_busid() {
	[[ $1 =~ $busid_re ]]
}

# valid_number N: N is a decimal number up to 65535 in canonical form (no
# sign, no leading zeros), so the kernel gets exactly the number checked.
valid_number() {
	[[ $1 =~ $number_re ]] && (($1 <= 65535))
}

# attr FILE: the value of a sysfs attribute, or nothing if it is absent.
attr() {
	local v=
	if [[ -e $1 ]]; then
		read -r v <"$1" || :
	fi
	printf '%s' "$v"
}

# write FILE VALUE: store VALUE in a sysfs attribute with a single write.
# Never creates FILE, so a wrong path fails instead of leaving a regular file.
write() {
	[[ -f $1 ]] || return 1
	printf '%s' "$2" >"$1"
}

# trusted PATH: refuse anything someone other than root could have written.
trusted() {
	local perm uid
	read -r perm _ uid _ < <(ls -ldnL -- "$1") || die "$1: cannot stat"
	[[ $uid == "$ROOT_UID" ]] || die "$1: must be owned by root"
	[[ ${perm:5:1} != w && ${perm:8:1} != w ]] || die "$1: must not be group or world writable"
}

# shared BUSID: the device on BUSID matches a line in the devices file. The
# whole file is read first: one invalid line rejects it, as it does for
# sshub-server. A missing file shares nothing.
shared() {
	local dev=$SYS/bus/usb/devices/$1 line n=0 found= vid pid serial want_serial
	trusted "$CONF"
	[[ -e $CONF/devices ]] || return 1
	trusted "$CONF/devices"
	vid=$(attr "$dev/idVendor")
	pid=$(attr "$dev/idProduct")
	serial=$(attr "$dev/serial")
	while IFS= read -r line || [[ -n $line ]]; do
		n=$((n + 1))
		if [[ $line =~ $skip_re ]]; then
			continue
		fi
		[[ $line =~ $device_re ]] || die "$CONF/devices:$n: invalid line"
		want_serial=${BASH_REMATCH[4]-}
		if [[ ${BASH_REMATCH[1]} == "$vid" && ${BASH_REMATCH[2]} == "$pid" ]] &&
			[[ -z $want_serial || $want_serial == "$serial" ]]; then
			found=1
		fi
	done <"$CONF/devices"
	[[ -n $found ]]
}

# driver BUSID: the driver bound to the device, or nothing.
driver() {
	local link=$SYS/bus/usb/devices/$1/driver
	if [[ -L $link ]]; then
		basename -- "$(readlink -- "$link")"
	fi
}

# bind BUSID: move the device from its current driver, if any, to usbip-host.
bind() {
	local busid=$1 drv
	drv=$(driver "$busid")
	if [[ -n $drv ]]; then
		write "$SYS/bus/usb/drivers/$drv/unbind" "$busid" || die "export $busid: unbind from $drv failed"
	fi
	write "$host/match_busid" "add $busid" || die "export $busid: match_busid failed"
	if ! write "$host/bind" "$busid"; then
		# Undo, so the device does not stay without a driver. Best effort:
		# the bind error is the one worth reporting.
		write "$host/match_busid" "del $busid" || :
		write "$SYS/bus/usb/drivers_probe" "$busid" || :
		die "export $busid: bind to usbip-host failed"
	fi
}

# export BUSID: bind the device to usbip-host, unless it already is, and hand
# it our stdin, a connected socket. The kernel takes its own reference to the
# socket, so sshub-server may close it afterwards.
cmd_export() {
	local busid=$1 dev status
	valid_busid "$busid" || die "export: invalid busid '$busid'"
	dev=$SYS/bus/usb/devices/$busid
	[[ -d $dev ]] || die "export $busid: no such device"
	# Like the stock usbip bind: exporting a hub would take every device
	# behind it away from the server.
	[[ $(attr "$dev/bDeviceClass") != 09 ]] || die "export $busid: device is a hub"
	shared "$busid" || die "export $busid: device is not shared"
	# The socket arrives as stdin, so no fd number is taken from the command
	# line. usbip-host itself checks that it is a stream socket.
	[[ -S /dev/stdin ]] || die "export $busid: stdin is not a socket"
	status=$(attr "$dev/usbip_status")
	case $status in
	'') bind "$busid" ;;
	1) ;; # left bound by an earlier session; reuse it
	2) die "export $busid: device is in use" ;;
	*) die "export $busid: device is in state '$status'" ;;
	esac
	# The kernel looks the number up in the writing process: this shell,
	# whose fd 0 is the socket.
	write "$host/$busid/usbip_sockfd" 0 || die "export $busid: handing over the socket failed"
}

# release BUSID: unbind the device from usbip-host and let the kernel probe
# its regular driver again. Does not consult the devices file: it can only
# give a device back to the server, and must still work after its share was
# removed.
cmd_release() {
	local busid=$1
	valid_busid "$busid" || die "release: invalid busid '$busid'"
	# A device that is gone (unplugged, or reset while exported) has nothing
	# to unbind, and the same holds for one not bound to usbip-host. Only the
	# match_busid entry may be left; without it, usbip-host would grab the
	# device when it comes back.
	if [[ ! -d $SYS/bus/usb/devices/$busid || $(driver "$busid") != usbip-host ]]; then
		# Not having an entry is the normal case, so failure is ignored.
		write "$host/match_busid" "del $busid" || :
		return 0
	fi
	write "$host/unbind" "$busid" || die "release $busid: unbind failed"
	write "$host/match_busid" "del $busid" || die "release $busid: match_busid failed"
	write "$SYS/bus/usb/drivers_probe" "$busid" || die "release $busid: reprobe failed"
}

# The client actions attach and detach through vhci's sysfs files, as the
# usbip tool does, but take the socket from stdin like export: there is no
# TCP connection for another local user to reach. Each port sshub attaches
# gets a record, $RUN/port<N>, holding "<uid> <devid>": who attached it, and
# what. detach and the udev rule (owner) go by it. A record whose port is
# free, or holds another device, means nothing; attach overwrites it.

# caller: the uid of who ran us. sudo sets SUDO_UID itself, whatever the
# caller's environment says. Run as root without sudo, it is root.
caller() {
	if [[ -z ${SUDO_UID-} ]]; then
		printf '%s' "$ROOT_UID"
		return
	fi
	[[ $SUDO_UID =~ ^(0|[1-9][0-9]{0,9})$ ]] || die "invalid SUDO_UID"
	printf '%s' "$SUDO_UID"
}

# ports: one line per vhci port, from the status files: hub (hs or ss), port
# number, state (004 free, 005 attaching, 006 in use, 007 error), devid in
# hex, and the local busid of the device on it (0-0 until it is in use).
ports() {
	local f hub port sta _spd dev _sockfd busid
	for f in "$vhci"/status "$vhci"/status.*; do
		[[ -f $f ]] || continue
		while read -r hub port sta _spd dev _sockfd busid; do
			[[ $hub == hs || $hub == ss ]] || continue
			[[ $port =~ ^[0-9]{1,5}$ ]] || die "$f: invalid port '$port'"
			printf '%s %d %s %s %s\n' "$hub" "$((10#$port))" "$sta" "$dev" "$busid"
		done <"$f"
	done
}

# record_owner PORT DEV: the uid in PORT's record if it is for DEV, the
# devid in hex as the status files show it. Nothing otherwise.
record_owner() {
	local uid devid
	read -r uid devid 2>/dev/null <"$RUN/port$1" || return 0
	[[ $uid =~ ^[0-9]{1,10}$ && $devid =~ ^[0-9]{1,10}$ ]] || return 0
	if [[ $(printf '%08x' "$devid") == "$2" ]]; then
		printf '%s' "$uid"
	fi
}

# attach SPEED BUSNUM DEVNUM: attach the device sshub-server is serving on
# our stdin, as described by its import reply, to a free vhci port. Prints
# the port.
cmd_attach() {
	local speed=$1 devid uid hub=hs port sta _ tmp
	valid_number "$speed" || die "attach: invalid speed '$1'"
	valid_number "$2" || die "attach: invalid busnum '$2'"
	valid_number "$3" || die "attach: invalid devnum '$3'"
	# The kernel looks up fd 0 in this shell, as for export.
	[[ -S /dev/stdin ]] || die "attach: stdin is not a socket"
	devid=$(($2 << 16 | $3))
	uid=$(caller)
	# SuperSpeed and faster devices go on the ss hub.
	if ((speed >= 5)); then
		hub=ss
	fi
	mkdir -p -m 0755 -- "$RUN"
	trusted "$RUN"
	# Another attach may take the same free port first: then the kernel
	# says busy, and the next free one is tried. The ports come in on fd 3:
	# fd 0 must stay the socket.
	while read -r -u 3 _ port sta _; do
		[[ $sta == 004 ]] || continue
		if ! write "$vhci/attach" "$port 0 $devid $speed"; then
			continue
		fi
		# The udev rule needs the record once the device is enumerated,
		# which takes network round trips after the write above.
		tmp=$RUN/.port$port.$$
		printf '%s %s\n' "$uid" "$devid" >"$tmp"
		mv -f -- "$tmp" "$RUN/port$port"
		printf '%s\n' "$port"
		return 0
	done 3< <(ports | grep "^$hub ")
	die "attach: no free vhci port took the device"
}

# detach PORT: detach the device on a vhci port the caller attached. A port
# that is already free counts as detached: the connection may have dropped.
cmd_detach() {
	local port=$1 uid hub p sta dev _
	valid_number "$port" || die "detach: invalid port '$port'"
	uid=$(caller)
	while read -r hub p sta dev _; do
		[[ $p == "$port" ]] || continue
		[[ $sta != 004 ]] || return 0
		if [[ $uid != "$ROOT_UID" && $(record_owner "$port" "$dev") != "$uid" ]]; then
			die "detach: port $port is not yours"
		fi
		# While the port is ours, no attach can claim it, so the
		# record goes first.
		rm -f -- "$RUN/port$port"
		write "$vhci/detach" "$port" || die "detach $port: failed"
		return 0
	done < <(ports)
	die "detach: no such port $port"
}

# owner DEVPATH: for the udev rule. If DEVPATH is a device sshub attached,
# or anything below it (interface, tty, ...), print SSHUB_OWNER=<uid>.
cmd_owner() {
	local re='^/devices/platform/vhci_hcd\.[0-9]+/usb[0-9]+/([0-9]+-[0-9]+)(/.*)?$'
	local busid _ port sta dev local_busid uid
	[[ $1 =~ $re ]] || return 0
	busid=${BASH_REMATCH[1]}
	while read -r _ port sta dev local_busid; do
		[[ $sta == 006 && $local_busid == "$busid" ]] || continue
		uid=$(record_owner "$port" "$dev")
		if [[ -n $uid ]]; then
			printf 'SSHUB_OWNER=%s\n' "$uid"
		fi
		return 0
	done < <(ports)
}

case ${1-}:$# in
export:2) cmd_export "$2" ;;
release:2) cmd_release "$2" ;;
attach:4) cmd_attach "$2" "$3" "$4" ;;
detach:2) cmd_detach "$2" ;;
owner:2) cmd_owner "$2" ;;
*) usage ;;
esac
